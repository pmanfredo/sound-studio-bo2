<Application x:Class="SoundStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:SoundStudio.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:NullToVisibilityConverter x:Key="NullToVisibility" />
            <local:NonZeroToVisibilityConverter x:Key="NonZeroToVisibility" />
            <local:InverseBoolConverter x:Key="InverseBool" />

            <!-- Two-option segmented switch (A/B) built from radio buttons. -->
            <Style x:Key="SegmentButton" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="4" Padding="12,5" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- "Modified" accent: warm amber, readable on dark and light. -->
            <SolidColorBrush x:Key="ModifiedBrush" Color="#F5A524" />
            <SolidColorBrush x:Key="ModifiedBackgroundBrush" Color="#33F5A524" />
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF6B6B" />

            <!-- "Pending" accent: staged but not yet applied. -->
            <SolidColorBrush x:Key="PendingBrush" Color="#5AB0FF" />
            <SolidColorBrush x:Key="PendingBackgroundBrush" Color="#335AB0FF" />

            <Style x:Key="PendingPill" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PendingBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PendingBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="7,1" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ModifiedPill" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ModifiedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ModifiedBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="7,1" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Grid cells: ellipsis instead of silently clipping, full text on hover. -->
            <Style x:Key="GridCellText" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
