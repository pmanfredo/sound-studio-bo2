<ui:FluentWindow x:Class="SoundStudio.App.LayersWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SoundStudio.App.ViewModels"
                 xmlns:controls="clr-namespace:SoundStudio.App.Controls"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:LayersViewModel}"
                 Title="Layer sounds"
                 Width="1080" Height="720" MinWidth="820" MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ShowInTaskbar="False"
                 AllowDrop="True">

    <ui:FluentWindow.Resources>
        <!-- Width of the track header column; the ruler and lanes line up with it. -->
        <GridLength x:Key="HeaderWidth">290</GridLength>
        <Style x:Key="IconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Layer sounds" ShowMaximize="True" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Layer24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Sound + add buttons -->
        <DockPanel Grid.Row="1" Margin="22,2,22,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Add files…" Icon="{ui:SymbolIcon Add24}" Margin="8,0,0,0" Command="{Binding AddFilesCommand}"
                           ToolTip="Add audio files as new layers (you can also drop files on this window)" />
                <ui:Button Content="Record…" Icon="{ui:SymbolIcon Mic24}" Margin="8,0,0,0" Command="{Binding RecordCommand}"
                           ToolTip="Record with your microphone and add the take as a layer" />
                <ui:Button Icon="{ui:SymbolIcon Games24}" Margin="8,0,0,0" Command="{Binding AddGameAudioCommand}"
                           Content="Game audio" ToolTip="Add what the game plays for this sound right now" />
                <ui:Button Icon="{ui:SymbolIcon History24}" Margin="8,0,0,0" Command="{Binding AddOriginalCommand}"
                           Content="Original" ToolTip="Add the untouched game audio from before it was changed"
                           Visibility="{Binding HasOriginal, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Target.Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Target.CategoryAndMap, Mode=OneWay}" /><Run Text=" · original " /><Run Text="{Binding TargetDurationText, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Tracks -->
        <Border Grid.Row="2" Margin="22,0,22,0" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Ruler row -->
                <Grid Grid.Row="0" Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource HeaderWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="14,4,12,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ZoomOut20}" Command="{Binding ZoomOutCommand}"
                                       ToolTip="Zoom out (Ctrl+scroll on the timeline)" />
                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ZoomIn20}" Command="{Binding ZoomInCommand}"
                                       ToolTip="Zoom in for finer positioning (Ctrl+scroll on the timeline)" />
                            <ui:Button Style="{StaticResource IconButton}" Content="Original" FontSize="12" Command="{Binding ZoomToOriginalCommand}"
                                       ToolTip="Zoom to the original sound's length" />
                            <ui:Button Style="{StaticResource IconButton}" Content="All" FontSize="12" Margin="0" Command="{Binding ZoomFitCommand}"
                                       ToolTip="Show the whole mix" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding LayerCountText}" />
                    </DockPanel>
                    <controls:TimelineRuler Grid.Column="1" Margin="0,0,12,0" />
                </Grid>
                <Border Grid.Row="0" VerticalAlignment="Bottom" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />

                <!-- Tracks -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource HeaderWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Layers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LayerViewModel}">
                                    <Grid Height="88">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource HeaderWidth}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />

                                        <!-- Track header -->
                                        <Grid Grid.Column="0" Margin="14,8,12,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0">
                                                <ui:SymbolIcon Symbol="{Binding Icon}" Margin="0,0,8,0" FontSize="16" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding InfoText}" FontSize="11" Margin="24,1,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <DockPanel Grid.Row="2" VerticalAlignment="Bottom">
                                                <ui:Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding PlayCommand}"
                                                           ToolTip="Play this layer on its own (or double-click its clip)">
                                                    <Grid>
                                                        <ui:SymbolIcon Symbol="Play20" Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        <ui:SymbolIcon Symbol="Stop20" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                </ui:Button>
                                                <ToggleButton DockPanel.Dock="Left" Padding="6" Margin="0,0,8,0" MinWidth="0" IsChecked="{Binding Muted}"
                                                              ToolTip="Mute: leave this layer out of the mix">
                                                    <Grid>
                                                        <ui:SymbolIcon Symbol="Speaker220" Visibility="{Binding Muted, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        <ui:SymbolIcon Symbol="SpeakerMute20" Visibility="{Binding Muted, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                </ToggleButton>
                                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                                           Icon="{ui:SymbolIcon MoreHorizontal20}" ToolTip="More" Click="More_Click">
                                                    <ui:Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Play on its own" Command="{Binding PlayCommand}" />
                                                            <MenuItem Header="Move to the start" Command="{Binding ResetOffsetCommand}" />
                                                            <MenuItem Header="Reset volume" Command="{Binding ResetGainCommand}" />
                                                            <Separator />
                                                            <MenuItem Header="{Binding Owner.EditExternallyLabel}" Command="{Binding EditExternallyCommand}" />
                                                            <MenuItem Header="Remove fades" Command="{Binding RemoveFadesCommand}" />
                                                            <Separator />
                                                            <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" />
                                                            <MenuItem Header="Move track up" Command="{Binding MoveUpCommand}" />
                                                            <MenuItem Header="Move track down" Command="{Binding MoveDownCommand}" />
                                                            <Separator />
                                                            <MenuItem Header="Remove layer" Command="{Binding RemoveCommand}" />
                                                        </ContextMenu>
                                                    </ui:Button.ContextMenu>
                                                </ui:Button>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding GainText}" Width="52" TextAlignment="Right"
                                                           VerticalAlignment="Center" FontSize="12"
                                                           ToolTip="Layer volume. Double-click the slider to reset." />
                                                <Slider Minimum="-24" Maximum="12" SmallChange="0.5" LargeChange="3" VerticalAlignment="Center"
                                                        IsSnapToTickEnabled="True" TickFrequency="0.5" Value="{Binding GainDb}"
                                                        MouseDoubleClick="GainSlider_DoubleClick"
                                                        ToolTip="Layer volume (double-click to reset)" />
                                            </DockPanel>
                                        </Grid>

                                        <!-- Lane -->
                                        <controls:TrackLane Grid.Column="1" Margin="0,0,12,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <controls:TimelineOverlay Grid.Column="1" Margin="0,0,12,0" />
                        <Border Grid.Column="0" HorizontalAlignment="Right" BorderThickness="0,0,1,0"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                    </Grid>
                </ScrollViewer>

                <!-- Empty -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasLayers, Converter={StaticResource InverseBoolToVisibility}}">
                    <ui:SymbolIcon Symbol="Layer24" FontSize="40" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No layers yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,4" />
                    <TextBlock Text="Add files, record, or add the game's own audio. Every layer plays on top of the others."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Scrolling through time when zoomed in -->
                <Grid Grid.Row="2" Margin="0,2,16,0" Visibility="{Binding IsZoomed, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource HeaderWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ScrollBar Grid.Column="1" Margin="0,0,12,0" Orientation="Horizontal" Minimum="0"
                               Maximum="{Binding ScrollMaximum}" ViewportSize="{Binding ViewSeconds}"
                               SmallChange="0.05" LargeChange="{Binding ViewSeconds}"
                               Value="{Binding ViewStart, Mode=TwoWay}" />
                </Grid>

                <!-- Hint -->
                <TextBlock Grid.Row="3" Margin="14,8,14,8" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding HasLayers, Converter={StaticResource BoolToVisibility}}"
                           Text="Drag a clip to change when it plays; it snaps to the start, other clips and where the original ends (hold Shift to move freely). Drag edges to trim, top corners to fade. Click the ruler to play from there. Ctrl+scroll zooms, Shift+scroll moves through time." />
            </Grid>
        </Border>

        <!-- Mix + done -->
        <Grid Grid.Row="3" Margin="22,12,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The whole mix -->
            <StackPanel Orientation="Horizontal">
                <ui:Button Padding="12,6" Margin="0,0,18,0" Command="{Binding PlayMixCommand}"
                           ToolTip="Play all layers together (Space)" IsEnabled="{Binding CanUse}" MinWidth="130">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsPlayingMix, Converter={StaticResource InverseBoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Play24" Margin="0,0,6,0" /><TextBlock VerticalAlignment="Center"><Run Text="Play mix  " /><Run Text="{Binding MixDurationText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsPlayingMix, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Stop24" Margin="0,0,6,0" /><TextBlock Text="Stop" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </ui:Button>
                <TextBlock Text="Overall volume" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Slider Width="200" Minimum="-24" Maximum="12" SmallChange="0.5" LargeChange="3"
                        IsSnapToTickEnabled="True" TickFrequency="0.5" VerticalAlignment="Center"
                        Value="{Binding MasterGainDb}" MouseDoubleClick="MasterSlider_DoubleClick"
                        ToolTip="Louder or quieter for the whole mix (double-click to reset)" />
                <TextBlock Text="{Binding MasterGainText}" Width="60" VerticalAlignment="Center" Margin="8,0,16,0" />
                <CheckBox Content="Prevent distortion" IsChecked="{Binding PreventClipping}" Margin="0,0,16,0" VerticalAlignment="Center"
                          ToolTip="Lower the overall volume just enough that the layers together don't clip" />
                <CheckBox IsChecked="{Binding CutToOriginal}" VerticalAlignment="Center"
                          ToolTip="End the mix where the original ends, with a short fade (the shaded part is left out)">
                    <TextBlock><Run Text="End where the original ends (" /><Run Text="{Binding TargetDurationText, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                </CheckBox>
            </StackPanel>

            <!-- Notes + buttons -->
            <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                    <ui:Button Content="Save WAV…" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,8,0" Command="{Binding SaveWavCommand}"
                               IsEnabled="{Binding CanUse}" ToolTip="Export the mix as a WAV file" />
                    <ui:Button Content="Cancel" Margin="0,0,8,0" Click="Close_Click" />
                    <ui:Button Content="Use as replacement" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"
                               Command="{Binding UseAsReplacementCommand}" IsEnabled="{Binding CanUse}"
                               ToolTip="Stage the mix; nothing is written to the game until you click Apply" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" FontSize="12"
                               Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding MixNote}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding MixNote, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding LengthWarning}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource ModifiedBrush}"
                               Visibility="{Binding LengthWarning, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
