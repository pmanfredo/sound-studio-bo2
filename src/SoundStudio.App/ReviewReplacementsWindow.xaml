<ui:FluentWindow x:Class="SoundStudio.App.ReviewReplacementsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SoundStudio.App.ViewModels"
                 Title="Replace sounds from files"
                 Width="760" Height="560" MinWidth="560" MinHeight="380"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Replace sounds from files" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,4,20,12">
            <TextBlock x:Name="SummaryText" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="ScopeText" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="2" Margin="20,0" CornerRadius="8" Padding="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ListView x:Name="MatchList" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MatchItemViewModel}">
                        <Grid Margin="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsMatched}"
                                      VerticalAlignment="Center" MinWidth="0" />
                            <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" Margin="4,0,8,0" />
                            <ui:SymbolIcon Grid.Column="2" Symbol="ArrowRight24" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="Target" Grid.Column="3" Text="{Binding TargetText}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetText}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMatched}" Value="False">
                                <Setter TargetName="Target" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Setter TargetName="Target" Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="3" Margin="20,14,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="TrimLongCheck" Grid.Column="0" IsChecked="True" VerticalAlignment="Center"
                      Content="Cut replacements to the original sound's length (safer for loading)" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click" />
                <ui:Button x:Name="StageButton" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Click="Stage_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
