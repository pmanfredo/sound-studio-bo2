<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SoundStudio.Core\SoundStudio.Core.csproj" />
    <ProjectReference Include="..\SoundStudio.Audio\SoundStudio.Audio.csproj" />
    <ProjectReference Include="..\SoundStudio.Sync\SoundStudio.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Identity -->
    <AssemblyName>SoundStudio</AssemblyName>
    <Product>Sound Studio</Product>
    <Description>Browse, replace, record and share Black Ops II sounds.</Description>
    <Version>1.0.1</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Velopack needs to run first thing in Main (install/update hooks), so Main is ours. -->
    <StartupObject>SoundStudio.App.Program</StartupObject>
  </PropertyGroup>

  <!-- Where installed copies look for updates; set by the release script (-p:UpdateSource=...). -->
  <ItemGroup>
    <AssemblyMetadata Include="UpdateSource" Value="$(UpdateSource)" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

</Project>
