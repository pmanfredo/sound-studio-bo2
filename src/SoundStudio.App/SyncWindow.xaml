<ui:FluentWindow x:Class="SoundStudio.App.SyncWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SoundStudio.App.ViewModels"
                 xmlns:sync="clr-namespace:SoundStudio.Sync;assembly=SoundStudio.Sync"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:SyncViewModel}"
                 Title="Share sounds"
                 Width="720" Height="720" MinWidth="600" MinHeight="560"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ShowInTaskbar="False">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Share sounds" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="People24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,4,22,22">

                <!-- Status -->
                <Border CornerRadius="8" Padding="16,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <DockPanel>
                        <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,12,0" VerticalAlignment="Center" Fill="Gray" />
                        <ui:Button DockPanel.Dock="Right" Content="Sync now" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding SyncNowCommand}"
                                   Visibility="{Binding IsOff, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Your name -->
                <DockPanel Margin="0,14,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Your name" VerticalAlignment="Center" Width="110" />
                    <ui:TextBox Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}" PlaceholderText="Shown to the people you sync with" />
                </DockPanel>

                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibility}}" />

                <!-- OFF: host or join -->
                <UniformGrid Columns="2" Margin="0,16,0,0" Visibility="{Binding IsOff, Converter={StaticResource BoolToVisibility}}">
                    <ui:Card Margin="0,0,8,0" Padding="18" VerticalAlignment="Stretch">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Server24" FontSize="28" HorizontalAlignment="Left" />
                            <TextBlock Text="Host" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,4" />
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Your PC keeps the shared changes. You get an invite code to send to the people you want to sync with. Works on your home network, over Tailscale, or over the internet." />
                            <ui:Button Content="Start hosting" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Margin="0,14,0,0"
                                       Command="{Binding StartHostingCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Windows may ask whether to allow Sound Studio on private networks. Click Allow." />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Margin="8,0,0,0" Padding="18" VerticalAlignment="Stretch">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="PersonAdd24" FontSize="28" HorizontalAlignment="Left" />
                            <TextBlock Text="Join" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,4" />
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Paste the invite code you were sent." />
                            <ui:TextBox Margin="0,10,0,0" PlaceholderText="SS1.…" Text="{Binding JoinCodeText, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" MaxHeight="90" FontFamily="Consolas" FontSize="12" />
                            <ui:Button Content="Join" Appearance="Primary" Icon="{ui:SymbolIcon ArrowEnterLeft24}" Margin="0,10,0,0"
                                       Command="{Binding JoinCommand}" />
                        </StackPanel>
                    </ui:Card>
                </UniformGrid>

                <!-- HOST -->
                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsHost, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Invite code" Style="{StaticResource SectionLabel}" />
                    <ui:TextBox Text="{Binding InviteCode, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" MaxHeight="90" />
                    <WrapPanel Margin="0,8,0,0">
                        <ui:Button Content="Copy invite code" Appearance="Primary" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,0" Command="{Binding CopyInviteCommand}" />
                        <ui:Button Content="New code" Icon="{ui:SymbolIcon KeyReset24}" ToolTip="Make a new secret; the old code stops working" Command="{Binding ResetInviteCommand}" />
                    </WrapPanel>
                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="The code is a password: only send it to people you trust with your sounds." />

                    <TextBlock Text="Others can reach you via" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
                    <ItemsControl ItemsSource="{Binding Routes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RouteItem}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <ui:SymbolIcon Symbol="{Binding Icon}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Optional: a stable address the user already has (named tunnel / reverse proxy) -->
                    <Border Margin="0,12,0,0" CornerRadius="8" Padding="14,10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="Your own internet address (optional)" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="If you have a domain with a Cloudflare tunnel or reverse proxy, point a hostname at" />
                                <Run Text="{Binding ForwardTarget, Mode=OneWay}" FontFamily="Consolas" />
                                <Run Text="and enter it here. Invite codes then keep working over the internet without resending. Leave empty if you don't have one." />
                            </TextBlock>
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="Check" Margin="8,0,0,0" Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                           Command="{Binding CheckPublicAddressCommand}" />
                                <ui:TextBox PlaceholderText="sounds.example.com" Text="{Binding PublicAddress, UpdateSourceTrigger=LostFocus}" />
                            </DockPanel>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding PublicAddressStatus}"
                                       Visibility="{Binding PublicAddressStatus, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" CornerRadius="8" Padding="14,10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel>
                            <ui:ToggleSwitch Content="Also share over the internet (Cloudflare quick tunnel)" IsChecked="{Binding ShareOverInternet}" />
                            <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="For people who aren't on your network or Tailscale. No account or port forwarding needed; the address changes each time." />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding TunnelStatus}"
                                       Visibility="{Binding TunnelStatus, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- HOST or JOINED: common actions -->
                <StackPanel Margin="0,18,0,0" Visibility="{Binding IsOff, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="People" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                    <TextBlock Text="Nobody else yet. Send the invite code." Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               x:Name="NoPeers" />
                    <ItemsControl ItemsSource="{Binding Peers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type sync:PeerInfo}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#808080" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock x:Name="State" Text="  · offline (their requests wait until they're back)" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Online}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="#3DD6B5" />
                                        <Setter TargetName="State" Property="Text" Value="  · online" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <CheckBox Margin="0,16,0,0" Content="Get others' changes automatically" IsChecked="{Binding AutoGet}"
                              ToolTip="They still wait under Pending changes so you can listen before applying" />
                    <CheckBox Margin="0,8,0,0" Content="Hide my sounds until applied" IsChecked="{Binding HideMine}"
                              ToolTip="Others won't see the file name or be able to listen until they apply it" />
                    <CheckBox Margin="0,8,0,0" Content="Hide others' sounds until applied" IsChecked="{Binding HideFromOthers}"
                              ToolTip="Don't show or play what others send until you apply it" />
                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button Content="Stop hosting" Icon="{ui:SymbolIcon Stop24}" Margin="0,0,8,8" Command="{Binding StopCommand}"
                                   Visibility="{Binding IsHost, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Leave" Icon="{ui:SymbolIcon SignOut24}" Margin="0,0,8,8" Command="{Binding StopCommand}"
                                   Visibility="{Binding IsJoined, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                </StackPanel>

                <TextBlock Margin="0,18,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="How it works: each install shares a list of the sounds it has changed (names and fingerprints only, no audio). Sound Studio compares that list with your game and shows only real differences under Available from others. Audio is sent only when someone clicks Get, straight from the person who has it; if they're offline, the request waits until they're back. What you get waits under Pending changes until you apply it." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
